{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git tag:*)",
      "Bash(git shortlog:*)",
      "Bash(git worktree list:*)",
      "Bash(ls:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(env:*)",
      "Bash(npm list:*)",
      "Bash(npm --version:*)",
      "Bash(npm outdated:*)",
      "Bash(npm view:*)",
      "Bash(npm explain:*)",
      "Bash(npm audit:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(node --version:*)",
      "Bash(node -e:*)",
      "Bash(tsc:*)",
      "Bash(vue-tsc:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(type:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "masked"
      }
    }
  }
}
